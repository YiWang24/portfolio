# =========================================================
# Public (client-side) environment variables
# =========================================================
NEXT_PUBLIC_SITE_URL=https://yoursite.com
NEXT_PUBLIC_DOCS_URL=https://docs.yoursite.com

# =========================================================
# Server-side environment variables
# Validated by src/server/env.ts at runtime (Zod schema).
# =========================================================

# --- LLM provider (OpenAI-compatible endpoint, e.g. GLM via Zhipu) -----------
OPENAI_COMPAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_COMPAT_API_KEY=
GLM_CHAT_MODEL=glm-4.5
GLM_EMBEDDING_MODEL=embedding-3
GLM_EMBEDDING_DIM=2048

# --- Neon Postgres (auto-injected by Vercel Neon integration) ---------------
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- Upstash Redis (auto-injected by Vercel Upstash integration) ------------
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- GitHub --------------------------------------------------------------- --
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- Resend -----------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Portfolio <noreply@yoursite.com>
CONTACT_EMAIL=you@yoursite.com

# --- Optional links surfaced by getContactCard ------------------------------
LINKEDIN_URL=
CALENDLY_URL=

# --- Admin ------------------------------------------------------------------
# Protects POST /api/rag/sync (must be >= 16 chars)
RAG_SYNC_KEY=

# --- Rate limits (optional; defaults shown) ---------------------------------
# CHAT_RATE_LIMIT_HOURLY=60
# CHAT_RATE_LIMIT_DAILY=300

# --- Observability --------------------------------------------------------- -
SENTRY_DSN=
